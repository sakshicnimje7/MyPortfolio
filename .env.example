# Environment variables for Sakshi Portfolio
# Copy this file to .env.local and fill in the values

# Database configuration
# Locally uses SQLite file dev.db. For production (Vercel), connect to Supabase or PostgreSQL.
DATABASE_URL="file:./dev.db"

# Supabase configuration (optional - for cloud analytics/storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
