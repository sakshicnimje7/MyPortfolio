datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  category    String   // "SAP" | "Java" | "AI" | "Frontend"
  shortDesc   String
  tags        String   // Comma-separated list of tags
  gitHubLink  String?
  viewLink    String
  createdAt   DateTime @default(now())
}
