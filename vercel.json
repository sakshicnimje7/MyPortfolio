{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sakshinimje.in"
        }
      ],
      "destination": "https://sakshinimje.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|svg|webp|gif|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
